# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: usada SOMENTE no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (e-mail) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Remetente em um domínio verificado no Resend
EMAIL_FROM="Zaff Experiência <avaliacoes@seudominio.com.br>"

# ── Aplicação ───────────────────────────────────────────────────────────────
# URL pública final, sem barra no fim (usada nos QR Codes e nos links do e-mail)
NEXT_PUBLIC_SITE_URL=https://avaliacao.seudominio.com.br
# Segredo do reenvio automático de e-mails (Vercel Cron envia como Bearer)
CRON_SECRET=
# Texto aleatório longo, usado para anonimizar IPs no controle de spam
IP_HASH_SALT=
